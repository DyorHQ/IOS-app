# DyorHQ web app — public configuration (copy to .env.local). Everything here ships to the browser.

# JSON-RPC endpoint used for reads. Defaults to Monad mainnet's public RPC (https://rpc.monad.xyz).
NEXT_PUBLIC_MONAD_RPC=

# Launchpad contract addresses. These override app/lib/deployment.json, which `npm run sync:deployment`
# fills from contracts/deployments/143.json after the owner runs the deploy script.
NEXT_PUBLIC_LAUNCHPAD_FACTORY=
NEXT_PUBLIC_LAUNCH_ROUTER=
NEXT_PUBLIC_FEE_ESCROW=
NEXT_PUBLIC_HOLDER_FEE_SHARING=
NEXT_PUBLIC_MEME_HOOK=
NEXT_PUBLIC_POOL_MANAGER=

# Extra ERC-20 pair tokens approved on the factory with setPairEconomics (comma separated). MON is always offered.
NEXT_PUBLIC_PAIR_TOKENS=
