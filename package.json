{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/web-security.test.mjs tests/no-secrets-in-build.test.mjs tests/launchpad-deployment.test.mjs tests/moments-deployment.test.mjs tests/moments-retired.test.mjs tests/kuru-swap.test.mjs tests/use-tx.test.mjs tests/use-async.test.mjs tests/perpl-feed.test.mjs tests/perpl-relay.test.mjs tests/rate-limit.test.mjs tests/perpl-candles.test.mjs tests/perps-order.test.mjs tests/send-checks.test.mjs tests/launchpad-events.test.mjs tests/format.test.mjs tests/design-system.test.mjs tests/clipboard.test.mjs tests/modal.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "abis": "node scripts/export-abis.mjs",
    "sync:deployment": "node scripts/sync-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "sync:moments": "node scripts/sync-moments-deployment.mjs",
    "keepers:test": "node --test contracts/keepers/test/abis.test.mjs contracts/keepers/test/decide.test.mjs contracts/keepers/test/jobs.test.mjs contracts/keepers/test/send.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
