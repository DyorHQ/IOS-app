#!/bin/bash
# dyorhq-leak-guard pre-push hook (tracked in .githooks/, set up by scripts/dev/install-hooks.sh).
# Checks every commit being pushed (git passes the refs on stdin) for forbidden paths and secrets, which also covers
# what the commit hooks never saw: rebases, cherry-picks, `git am`, commits made with --no-verify or in a clone without
# the hooks. Locations and names only, never values; a missing checker blocks the push too.
top=$(git rev-parse --show-toplevel) || exit 1
refs=$(cat)
# A traced or BASH_ENV-injected shell could print the values the scanner holds.
run() { env -u BASH_ENV -u SHELLOPTS /bin/bash "$top/scripts/dev/$1" "${@:2}"; }
status=0
printf '%s\n' "$refs" | run forbidden-paths.sh --pre-push "$@" || status=1
printf '%s\n' "$refs" | run secret-scan.sh --pre-push "$@" || status=1
exit $status
