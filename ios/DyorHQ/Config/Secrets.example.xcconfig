// Copy to Secrets.xcconfig (git-ignored) and fill in. Every value ships inside the app bundle, so only public
// identifiers belong here. See docs/env-setup.md in the repository root for where each comes from.

// Privy dashboard → App ID, and Clients → the mobile client created for bundle id xyz.dyorhq.app / scheme dyorhq.
PRIVY_APP_ID =
PRIVY_CLIENT_ID =

// Optional dedicated Monad mainnet RPC; the public https://rpc.monad.xyz is used when empty.
MONAD_RPC_URL =

// Passkey relying party: the HTTPS host that serves /.well-known/apple-app-site-association for xyz.dyorhq.app.
PASSKEY_RP_ID =

// Perpl builder code (1–255), 0 for none.
PERPL_BUILDER_ID = 0

// Launchpad contracts, from contracts/deployments/143.json after you deploy.
LAUNCHPAD_FACTORY =
LAUNCH_ROUTER =
FEE_ESCROW =
HOLDER_FEE_SHARING =
MEME_HOOK =

// Apple Developer team for automatic signing.
DEVELOPMENT_TEAM =
