# Response headers for static files (Cloudflare Workers static assets). Worker responses get the same security set
# from worker/index.ts. vinext only writes its own _headers when this file is absent, so its cache rule is kept below.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Cache content-hashed assets immutably (the rule vinext generates)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
