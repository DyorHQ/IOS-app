# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/scripts/mera-parity/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# nested Expo repo (tracked as its own git repo) and archive snapshot
/mainstreet-app/
/mainstreet-repo.tar.gz

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# example env is safe to commit
!.env.example

# secrets and signing material that must never be committed (security audit 2026-09-26)
.dev.vars
.dev.vars.*
*.p8
*.p12
*.mobileprovision
*.keystore
.claude/settings.local.json
